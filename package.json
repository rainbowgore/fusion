{
  "name": "fusion",
  "version": "0.0.0",
  "description": "Client-agnostic governing layer for LLM observability: capture, govern routing, and wire any client to Langfuse (local + cloud).",
  "type": "module",
  "bin": {
    "fusion": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "fusion": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/functional/*.test.ts",
    "test:functional": "tsx --test --test-timeout=120000 --test-concurrency=1 tests/functional/*.test.ts",
    "test:claims": "tsx --test --test-timeout=60000 --test-concurrency=1 tests/claims/suite.test.ts",
    "test:hermes": "tsx --test --test-timeout=180000 tests/hermes-user-path.test.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^12.1.0",
    "smol-toml": "^1.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
